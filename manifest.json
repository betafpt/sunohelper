{
  "manifest_version": 3,
  "name": "G.Rythm AI Manager",
  "version": "1.0",
  "description": "Generate Suno lyrics and music styles effortlessly using OpenAI API.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.suno.com/*"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "G.Rythm AI Manager",
    "default_icon": {
      "16": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.suno.com/*"],
      "js": ["scripts/content.js"],
      "css": ["scripts/content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon128.png", "icons/logo.png"],
      "matches": ["*://*.suno.com/*"]
    }
  ]
}
